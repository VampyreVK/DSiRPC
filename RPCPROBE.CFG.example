# DSiRPC SD card config. Copy this to the SD card root as RPCPROBE.CFG
# (exact 8.3 name). The DSi reads it once at boot, so no rebuild is needed
# to change anything here. Keep the file short: only the first 1 KB is read.
#
# The Wi-Fi connection itself comes from the DSi's own saved settings
# (connection slots 4-6), so no network name or password goes in here.

# The PC running the DSiRPC scripts.
pc_ip=192.168.2.196
# UDP port, used on both ends. Optional, defaults to 4244.
port=4244
# Optional: the PC's MAC address (AA:BB:CC:DD:EE:FF). Empty = broadcast.
pc_mac=
# Optional fallback for the DSi's own IP. The launcher's DHCP address wins.
dsi_ip=
