# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc

# Cursor  
#  Cursor is an AI-powered code editor.`.cursorignore` specifies files/directories to 
#  exclude from AI features like autocomplete and code analysis. Recommended for sensitive data
#  refer to https://docs.cursor.com/context/ignore-files
.cursorignore
.cursorindexingignore
# RAM dumps at the repo root (they contain your save data). Root only:
# nds-bootstrap tracks hundreds of .bin files it needs to build.
/*.bin
# DSiRPC's settings (dsirpc.py setup writes it; PokemonPlatinumRPC.cfg is the old name)
dsirpc.cfg
dsirpc.cfg.tmp
PokemonPlatinumRPC.cfg

# --- DSiRPC ---
# The launcher's handoff file, and the old SD card config (no longer used;
# old copies can hold a Wi-Fi password)
RPCPROBE.CFG
RPCHAND.TXT
# Editor settings
.vscode/
# DS build outputs (launcher and spikes; nds-bootstrap has its own .gitignore)
*.nds
*.elf
# DSiRPC's log and state file, and test outputs (tools/frame_check.py --save)
logs/
# The Windows download (packaging/build_release.py) and what only it has
/dist/
/python/
/defaults.cfg
# RetroAchievements set files (dsirpc.py setup, tools/ra_tool.py add): RA's game data, kept local
/ra/*
!/ra/README.md
.DS_Store
